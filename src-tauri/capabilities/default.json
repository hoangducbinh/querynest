{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local workspace window; save only files chosen by the user",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-save",
    "fs:allow-write-text-file"
  ]
}
